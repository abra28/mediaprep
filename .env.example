# Copy this file to .env and fill in your values

# PlanetScale (or any MySQL) database URL
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://root:password@localhost:3306/preservice

# For production, use your PlanetScale connection string:
# DATABASE_URL=mysql://xxxxxxxxxx:pscale_pw_xxxxxxxxxx@xxxxxxxxxx.ap-southeast-2.psdb.cloud/preservice?ssl={"rejectUnauthorized":true}

# Node environment
NODE_ENV=production

# Port (Render sets this automatically, but default is 3000)
# PORT=3000
